# Sentinel settings. Copy to .env and fill in what you have. Never commit .env (it is git-ignored).
# Every variable is optional: with none set, Sentinel runs fully offline on its fallbacks.

# --- Brain (any OpenAI-compatible endpoint; Groq by default) ---
# Without a key the rules bank answers health and mission questions, and general questions get
# "I need a connection to answer that". The same key is used for Groq Whisper speech recognition.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
LLM_API_KEY=

# --- Claude brain (Anthropic), optional ---
# API key from https://platform.claude.com > API keys (needs API credit). Without it, the brain above is used.
ANTHROPIC_API_KEY=
# Optional: the Claude model (default claude-sonnet-5-5) and a spending stop in US dollars (default 4.50).
# Spending so far is in data/claude_usage.json and on /api/health. Past the stop, Groq answers.
# CLAUDE_MODEL=claude-sonnet-5-5
# CLAUDE_BUDGET_USD=4.50

# --- Voice (text to speech) ---
# ElevenLabs first (flash model, premade voices only), then Kokoro on this laptop, then the browser.
ELEVENLABS_API_KEY=
# Hard cap on ElevenLabs characters this install may spend (counted in data/tts_usage.json).
ELEVENLABS_CHAR_BUDGET=9000
# Set to "kokoro" to never call ElevenLabs (tests, rehearsals, saving credit).
SENTINEL_TTS=

# --- Twi Voice (Khaya AI / GhanaNLP) ---
# Keys from https://translation.ghananlp.org (Profile > subscription keys). Without them Twi shows text only.
KHAYA_KEY=
KHAYA_KEY_SECONDARY=

# --- Server ---
# Shown in the demo panel; run.ps1 sets it to the LAN HTTPS address automatically.
SENTINEL_TABLET_URL=
# Developer switches (the test suite sets these itself):
#   SENTINEL_NO_PERSIST=1   keep state in memory only (no data/state.json)
#   SENTINEL_FRESH=1        start from shared/mock_data.json, ignoring saved state
#   SENTINEL_NO_NETWORK=1   do not fetch NOAA space weather (use the saved snapshot)
#   SENTINEL_NO_WARM=1      do not pre-load Kokoro at start-up
