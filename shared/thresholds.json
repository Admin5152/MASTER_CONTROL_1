  "radiation": {
    "career_limit_msv": {
      "value": 600,
      "kind": "nasa",
      "note": "[V1 4030] An individual astronaut's total career effective radiation dose due to space flight radiation exposure shall be less than 600 mSv.",
      "source": {
        "title": "NASA OCHMO-TB-020 Design for Ionizing Radiation Protection (radiation protection technical brief)",
        "url": "https://www.nasa.gov/wp-content/uploads/2023/03/radiation-protection-technical-brief-ochmo.pdf"
      }
    },
    "spe_event_limit_msv": {
      "value": 250,
      "kind": "nasa",
      "note": "Short-term exposure to solar particle events limited to an effective dose of 250 mSv per event.",
      "source": {
        "title": "NASA OCHMO-TB-020 radiation protection technical brief",
        "url": "https://www.nasa.gov/wp-content/uploads/2023/03/radiation-protection-technical-brief-ochmo.pdf"
      }
    },
    "dose_rates_msv_day": {
      "iss": {
        "value": 0.35,
        "kind": "nasa",
        "note": "On the ISS effective doses accumulate at approximately 0.2 to 0.5 mSv/day (40 to 90 mSv per six-month mission). 0.35 is the midpoint of that range, chosen by this build.",
        "source": {
          "title": "Simonsen, Zawaski, Weeks: Moon 2 Mars Space Radiation Protection, Buying Down Risks to Crew (NASA, NTRS 20250006168)",
          "url": "https://ntrs.nasa.gov/citations/20250006168"
        }
      },
      "lunar": {
        "value": 1.37,
        "kind": "demo_placeholder",
        "note": "Approximate lunar-surface dose equivalent rate measured by the Chang'e-4 Lunar Lander Neutron and Dosimetry experiment (1,369 microSv/day). Peer-reviewed but not a NASA figure, so marked demo_placeholder.",
        "source": {
          "title": "Zhang et al. 2020, First measurements of the radiation dose on the lunar surface, Science Advances",
          "url": "https://www.science.org/doi/10.1126/sciadv.aaz1334"
        }
      },
      "mars_transit": {
        "value": 1.8,
        "kind": "nasa",
        "note": "Curiosity RAD measured an average of 1.8 milliSieverts of GCR per day during cruise to Mars (Zeitlin et al., Science, 31 May 2013).",
        "source": {
          "title": "NASA JPL: Data from NASA rover's voyage to Mars aids planning (30 May 2013)",
          "url": "https://www.jpl.nasa.gov/news/data-from-nasa-rovers-voyage-to-mars-aids-planning/"
        }
      },
      "mars_surface": {
        "value": 0.67,
        "kind": "nasa",
        "note": "Average GCR dose equivalent rate of 0.67 mSv/day on the Martian surface, August 2012 to June 2013 (Hassler et al., Science, 2014). The often-quoted 0.64 could not be confirmed on a primary page, so 0.67 is used.",
        "source": {
          "title": "SwRI: SwRI scientists publish first radiation measurements from the surface of Mars (Dec 2013); NASA NTRS 20180007641",
          "url": "https://www.swri.org/press-release/swri-scientists-publish-first-radiation-measurements-surface-mars"
        }
      }
    },
    "storm_scale": {
      "kind": "nasa",
      "note": "NOAA Solar Radiation Storm scale: flux level of >=10 MeV particles (pfu). NOAA is not NASA; kind 'nasa' is used here for an official US government space-weather standard.",
      "source": {
        "title": "NOAA SWPC: NOAA Space Weather Scales",
        "url": "https://www.swpc.noaa.gov/noaa-scales-explanation"
      },
      "levels": [
        {
          "level": 1,
          "pfu": 10
        },
        {
          "level": 2,
          "pfu": 100
        },
        {
          "level": 3,
          "pfu": 1000
        },
        {
          "level": 4,
          "pfu": 10000
        },
        {
          "level": 5,
          "pfu": 100000
        }
      ]
    },
    "flag_storm_level": {
      "demoDefault": true,
      "value": 3,
      "kind": "demo_placeholder",
      "note": "Demo S3 shelter trigger from RAD-3/RAD-4. Reviewed MRIDs describe monitoring and contingency operations but do not establish this threshold.",
      "source": {
        "title": "Sentinel build spec",
        "url": ""
      }
    },
    "shelter_reduction": {
      "demoDefault": true,
      "value": 0.5,
      "kind": "nasa",
      "note": "Aluminium and polyethylene provide an average 50% reduction in dose from SPE radiation (GCR only about 7%). Used as the shelter factor for storm dose only.",
      "source": {
        "title": "NASA OCHMO-TB-020 radiation protection technical brief, Engineering Countermeasures",
        "url": "https://www.nasa.gov/wp-content/uploads/2023/03/radiation-protection-technical-brief-ochmo.pdf"
      }
    },
    "storm_extra_msv_hour": {
