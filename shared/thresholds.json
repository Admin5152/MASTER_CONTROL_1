{
  "_doc": "Every limit Sentinel uses. Each level carries kind (nasa | clinical_reference | demo_placeholder) and source {title, url}. The brain loads this file; the UI shows kind and source next to every threshold. See shared/SOURCES.md for how each number was checked.",
  "absolute": {
    "cabin.oxygen_pct": {
      "label": "Cabin oxygen",
      "unit": "%",
      "zone": "cabin",
      "levels": [
        {
          "severity": "alert",
          "below": 19.5,
          "kind": "clinical_reference",
          "note": "Oxygen-deficient atmosphere is defined as below 19.5% O2 by volume. Occupational safety reference, not a NASA limit.",
          "source": {
            "title": "OSHA 29 CFR 1910.146 Permit-required confined spaces (definitions)",
            "url": "https://www.osha.gov/laws-regs/regulations/standardnumber/1910/1910.146"
          }
        },
        {
          "severity": "alert",
          "below": 17.1,
          "kind": "nasa",
          "note": "NASA-STD-3001 Vol 2 [V2 6003] Table 6.2-1 gives an absolute lower limit of PIO2 122 mmHg (1-hour TWA). At 14.7 psia (760 mmHg) cabin: FiO2 = 122 / (760 - 47) = 0.171, i.e. 17.1% O2. Conversion by this build.",
          "source": {
            "title": "NASA OCHMO-TB-003 Habitable Atmosphere, Rev A (2023)",
            "url": "https://www.nasa.gov/wp-content/uploads/2023/12/ochmo-tb-003-habitable-atmosphere.pdf"
          }
        }
      ]
    },
    "cabin.co2_ppm": {
      "label": "Cabin CO2",
      "unit": "ppm",
      "zone": "cabin",
      "levels": [
        {
          "severity": "watch",
          "above": 3289,
          "kind": "nasa",
          "note": "Brief: to keep headache risk below 1%, average 7-day CO2 below 2.5 mmHg. 2.5 / 760 x 1e6 = 3,289 ppm at 14.7 psia.",
          "source": {
            "title": "NASA OCHMO-TB-004 Carbon Dioxide (2023)",
            "url": "https://www.nasa.gov/wp-content/uploads/2023/12/ochmo-tb-004-carbon-dioxide.pdf"
          }
        },
        {
          "severity": "alert",
          "above": 3947,
          "kind": "nasa",
          "note": "NASA-STD-3001 Vol 2 Rev D [V2 6004]: average one-hour ppCO2 no more than 3 mmHg. 3 / 760 x 1e6 = 3,947 ppm at 14.7 psia (760 mmHg) cabin pressure. Conversion by this build.",
          "source": {
            "title": "NASA OCHMO-TB-004 Carbon Dioxide (2023)",
            "url": "https://www.nasa.gov/wp-content/uploads/2023/12/ochmo-tb-004-carbon-dioxide.pdf"
          }
        }
      ]
    },
